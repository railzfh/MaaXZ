{
    "interface_version": 2,
    "name": "MaaXZ",
    "description": "《太古仙尊》自动化助手。由 MaaFramework 强力驱动！",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaXZ!",
    "github": "https://github.com/railzfh/MaaXZ",
    "version": "1.0.0",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "../agent/main.py"
        ]
    },
    "task": [
        {
            "name": "启动游戏",
            "entry": "启动游戏"
        },
        {
            "name": "确保主界面（守卫）",
            "entry": "回到主界面",
            "pipeline_override": {
                "通用_守卫出口": {
                    "next": []
                }
            }
        },
        {
            "name": "人间_历练",
            "entry": "人间_历练",
            "pipeline_override": {
                "人间_历练": {
                    "next": [
                        "回到主界面"
                    ]
                },
                "通用_守卫出口": {
                    "next": [
                        "人间_历练_进历练"
                    ]
                }
            }
        },
        {
            "name": "整理背包（预览·只识别不勾选）",
            "entry": "整理背包",
            "pipeline_override": {
                "整理背包": {
                    "next": [
                        "回到主界面"
                    ]
                },
                "通用_守卫出口": {
                    "next": [
                        "打开储物袋"
                    ]
                },
                "打开一键出售_校验": {
                    "next": [
                        "整理背包_预览"
                    ]
                }
            }
        },
        {
            "name": "整理背包（每种留2格）",
            "entry": "整理背包",
            "pipeline_override": {
                "整理背包": {
                    "next": [
                        "回到主界面"
                    ]
                },
                "通用_守卫出口": {
                    "next": [
                        "打开储物袋"
                    ]
                },
                "打开一键出售_校验": {
                    "next": [
                        "整理背包_勾选"
                    ]
                }
            }
        }
    ]
}