    "主界面_判据_汇总": {
        "doc": "【判据·汇总·表驱动】所有已知主界面的特征词一次全列出。⚠️ 以后再加一种主界面，只往 expected 里加它的词（agent/guard.py 的 ZONES 表同步加一行），判定/守卫/恢复逻辑都不用改",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "宗门",
                    "比斗",
                    "太虚",
                    "道使",
                    "游历",
                    "福地",
                    "门派",
                    "洞府",
                    "历练"
                ],
                "roi": [
                    0,
