{
    "回到主界面": {
        "doc": "★可复用部件①【回到主界面】—— 任何顺序脚本的第一步都接它，把界面从任何地方拉回主界面（仙界 或 人间 都算），拉不回就硬失败走 on_error。内部三层策略：① 先关掉盖在主界面上的弹窗（先用模板定位弹窗自己的 X，认不到才用兜底坐标）② 点返回箭头 / 叉 ③ 固定坐标与「确定」轮换兜底；并以「界面连续多轮没变化」作为换招信号。⚠️ 调用方需用 pipeline_override 把它的后续任务主体接到「通用_守卫出口」（见 doc 末尾用法）",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "maa_agent_guard_ensure_main"
            }
        },
        "next": [
            "通用_守卫出口"
        ],
        "on_error": [
            "通用_守卫失败"
        ]
    },
    "切到指定界": {
        "doc": "★可复用部件②【切到指定界】—— 需要指定主界面时接它。界名由 custom_action_param.zone 传入（\"仙界\" / \"人间\"，默认\"仙界\"）。幂等：已在目标界则什么都不做；不在则点左上角图标区第二行最左的「界切换」按钮（该按钮显示的是「要切过去的界」），点完复判。用法：action = {\"type\":\"Custom\",\"param\":{\"custom_action\":\"maa_agent_switch_zone\",\"custom_action_param\":{\"zone\":\"人间\"}}}",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "maa_agent_switch_zone",
                "custom_action_param": {
                    "zone": "仙界"
                }
            }
        },
        "next": [
            "通用_守卫出口"
        ],
        "on_error": [
            "通用_守卫失败"
        ]
    },
    "通用_守卫出口": {
        "doc": "★【回到主界面】/【切到指定界】之后的公共出口。**调用方必须用 pipeline_override 把它的 next 改成自己的任务主体**，否则任务到这里就结束了。",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "通用_守卫失败": {
        "doc": "★拉不回主界面 / 切界失败时的终点：到此停下，不在未知界面上乱点。",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "主界面_判据_人间": {
        "doc": "【判据·备查】当前是否在「人间/凡界」主界面：底部导航为 福地/门派/洞府/历练。纯识别节点、不动作；供调试或 pipeline_override 引用",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "福地",
                    "门派",
                    "洞府",
                    "历练"
                ],
                "roi": [
                    0,
                    960,
                    720,
                    90
                ],
                "threshold": 0.6
            }
        },
        "action": {
            "type": "DoNothing"
        }
    },
    "主界面_判据_仙界": {
        "doc": "【判据·备查】当前是否在「仙界」主界面：底部导航为 宗门/比斗/太虚/道使/游历。纯识别节点、不动作",
        "recognition": {
            "type": "OCR",
