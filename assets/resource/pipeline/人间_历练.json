    "人间_历练_神游_开始或跳过": {
        "doc": "★用一个 Custom 动作处理神游弹窗的**两种状态**：①未开始（有次数框+[开始神游]）→ 点最大次数(540,976)、再点开始神游(359,1039) ②**进行中**（显示「神游常羊山 x/70」进度条+[神魂归窍]，没有开始按钮）→ 整段跳过。两种都返回成功，不断链",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "maa_agent_run_if_not_found",
                "custom_action_param": {
                    "skip_if_found": [
                        "神魂归窍",
                        "神游常羊山"
                    ],
                    "skip_roi": [
                        0,
                        960,
                        720,
                        140
                    ],
                    "steps": [
                        {
                            "click": [
                                540,
                                976
                            ],
                            "wait": 1.0
                        },
                        {
                            "click": [
                                359,
                                1039
                            ],
                            "wait": 2.5
                        }
                    ]
                }
            }
        },
        "post_delay": 500,
        "next": [
            "人间_历练_神游_关弹窗"
        ],
        "on_error": [
            "人间_历练_神游_关弹窗"
        ]
    }
