    "人间_历练_跑商_认2000": {
        "doc": "★「有则点、无则跳过」用 Custom 动作实现（不再用 pipeline 的识别分支 —— 实测识别不命中会终止任务链）。在用户选区 [404,848,148,52] 找「2000」：找到就点，找不到就不点；两种情况都继续走到「返回」",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "maa_agent_click_if_found",
                "custom_action_param": {
                    "expected": [
                        "2000"
                    ],
                    "roi": [
                        404,
                        848,
                        148,
                        52
                    ],
                    "threshold": 0.6,
                    "target": [
                        497,
                        874
                    ]
                }
            }
        },
        "post_delay": 500,
        "next": [
            "人间_历练_跑商_返回"
        ],
        "on_error": [
            "人间_历练_跑商_返回"
        ]
    },
