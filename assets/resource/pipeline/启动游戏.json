    "主界面": {
        "doc": "终点：游戏主界面。以玩家名（含区服前缀 s521）与底部「宗门」入口同时命中为判据",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "type": "OCR",
                        "param": {
                            "expected": [
                                "s521"
                            ],
                            "roi": [
                                100,
                                10,
                                300,
                                60
                            ]
                        }
                    },
                    {
                        "type": "OCR",
