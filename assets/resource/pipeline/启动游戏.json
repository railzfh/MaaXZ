    "关闭离线收益": {
        "doc": "进游戏后的「离线收益」结算弹窗：点右上角 X 关闭。它弹出后会自动消失（时序不稳），所以给较长的识别窗口 + 高频轮询来抓它；没抓到就直接走主界面",
        "max_hit": 3,
        "rate_limit": 500,
        "timeout": 8000,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "离线收益"
                ],
                "roi": [
                    240,
                    250,
                    240,
                    60
                ],
                "threshold": 0.3
