{
    "启动游戏": {
        "doc": "任务入口：从桌面按包名拉起《太古仙尊》。冷启动要 20s+，期间会先弹公告，所以拉起后统一交给分诊节点做分发",
        "action": {
            "type": "StartApp",
            "param": {
                "package": "com.xyjx.hardtime.aligames"
            }
        },
        "post_delay": 12000,
        "next": [
            "分诊"
        ]
    },
    "分诊": {
        "doc": "弹窗分诊入口：没有公告之后，按「隐私协议 → 公告确定 → 登录界面」的顺序确认该走哪条路（都是候选，第一个命中的赢）",
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "隐私协议_同意",
            "公告_确定",
            "登录界面"
        ]
    },
    "公告_关闭": {
        "doc": "关公告/活动弹窗：认标题栏的「公告」，点右上角 X。用 next 自环以连续关闭叠着的多个弹窗；max_hit 兜底防止认错导致死循环",
        "max_hit": 8,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "公告"
                ],
                "roi": [
                    240,
                    250,
                    240,
                    70
                ],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    602,
                    321
                ]
            }
        },
        "post_delay": 1500,
        "next": [
            "公告_关闭",
            "分诊"
        ]
    },
    "公告_确定": {
        "doc": "兜底：公告没有可点的 X，只有底部「确定」时点它（点完会回登录界面）",
        "max_hit": 5,
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "确定"
                ],
                "roi": [
                    220,
                    920,
                    280,
                    90
                ],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "next": [
            "公告_关闭"
        ]
    },
    "隐私协议_同意": {
        "doc": "首次启动的用户隐私协议弹窗：点右下金色「同意」（左侧「拒绝并退出」绝不能点）",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "同意"
                ],
                "roi": [
                    420,
                    950,
                    150,
                    60
                ],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "next": [
            "分诊"
        ]
    },
    "登录界面": {
        "doc": "登录界面就绪判据：底部「开始游戏」按钮出现。命中后继续确认区服；未命中说明还在公告/加载，回公告处理",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "开始游戏"
                ],
                "roi": [
                    220,
                    930,
                    300,
                    100
                ],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "next": [
            "验证区服"
        ],
        "on_error": [
            "公告_关闭"
        ]
    },
    "验证区服": {
        "doc": "校验当前所选区服是否为 521 区（登录界面显示「五百二十一 川流」）。命中则点「开始游戏」；未命中转去换区",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "五百二十一"
                ],
                "roi": [
                    180,
                    820,
                    380,
                    60
                ],
                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    357,
                    982
                ]
            }
        },
        "post_delay": 6000,
        "next": [
            "公告_关闭",
            "关闭离线收益",
            "主界面"
        ],
        "on_error": [
            "打开区服列表"
        ]
    },
    "打开区服列表": {
        "doc": "区服不是 521 时：点登录界面的区服行，展开选区面板",
        "recognition": {
            "type": "OCR",
            "param": {
                "expected": [
                    "区"
                ],
                "roi": [
                    200,
                    830,
                    320,
                    40
