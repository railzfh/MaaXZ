                "threshold": 0.3
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        },
        "post_delay": 2000,
        "next": [
            "选择521区"
        ]
    },
    "选择521区": {
        "doc": "在选区面板的「最近登录」里点「五百二十一 川流」",
